<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/poster_bg">
    <TextView android:id="@+id/hero_letter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@android:color/transparent"
        android:textSize="1sp"
        android:visibility="gone"/>
    <ImageView android:id="@+id/hero_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="48dp"
        android:scaleType="fitCenter"
        android:contentDescription="logo"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_hero"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="18dp">
        <TextView android:id="@+id/hero_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>
        <TextView android:id="@+id/hero_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button android:id="@+id/hero_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶  Regarder"
                android:textColor="#000000"
                android:textStyle="bold"
                android:background="@drawable/btn_play"
                android:paddingHorizontal="22dp"
                android:minHeight="40dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>