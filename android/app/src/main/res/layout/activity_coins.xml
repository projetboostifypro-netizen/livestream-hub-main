<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recharger des pièces"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView android:id="@+id/coins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Montant"
            android:textColor="@color/text"/>

        <LinearLayout android:id="@+id/packs"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:background="@color/card"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="Saisir un montant (min. 500 FCFA)"
            android:inputType="number"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Opérateur"
            android:textColor="@color/text"/>

        <Spinner android:id="@+id/operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Numéro de téléphone"
            android:textColor="@color/text"/>

        <EditText android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@color/card"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="Ex: 0700000000"
            android:inputType="phone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Code OTP (Orange Money)"
            android:textColor="@color/text"/>

        <EditText android:id="@+id/otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@color/card"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="Laisser vide si MTN/Moov/Wave"
            android:inputType="number"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Orange Money : composez #144*82*MONTANT*CODE# pour obtenir un OTP.\nMTN/Moov/Wave : laissez vide, vous recevrez une notification à valider."
            android:textColor="@color/muted"
            android:textSize="12sp"/>

        <Button android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="14dp"
            android:text="Payer"
            android:textColor="#004E80"
            android:textStyle="bold"
            android:background="#FFFFFF"/>

        <TextView android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/muted"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Dépôt minimum : 100 FCFA. Paiement Mobile Money via SoleasPay."
            android:textColor="@color/muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>